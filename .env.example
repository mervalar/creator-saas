# ─────────────────────────────────────────────────────────
# SHARED — used by both frontend and backend
# ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/creator_saas
REDIS_URL=redis://localhost:6379

# ─────────────────────────────────────────────────────────
# FRONTEND — /frontend/.env.local
# ─────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_min_32_chars

# Google OAuth (https://console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Backend API base URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:4000

# ─────────────────────────────────────────────────────────
# BACKEND — /backend/.env
# ─────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# Must match NEXTAUTH_SECRET
JWT_SECRET=your_nextauth_secret_min_32_chars

# Allow requests from frontend
FRONTEND_URL=http://localhost:3000

# AI APIs
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Platform OAuth credentials
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# n8n automation
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/posting
N8N_API_KEY=

# File storage
UPLOAD_DIR=/var/uploads/creator-saas
LOG_LEVEL=info
